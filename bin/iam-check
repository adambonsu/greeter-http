#!/usr/bin/env ruby
# frozen_string_literal: true

# iam-check — least-privilege gate for the GreeterFunction's EXECUTION-ROLE
# policy (the SAM `Policies:` block on the function). It does NOT police the
# KMS key's resource policy, which legitimately uses `kms:*` for the account
# root and `Resource: "*"` — that is standard for a key policy and a different
# concern from "what may the Lambda do".
#
# Fails (exit 1) if the function's inline policy:
#   * uses a "*" wildcard in any Action or Resource, OR
#   * grants an action outside the allowed set, OR
#   * grants a resource outside the allowed set (GreetingsTable / EncryptionKey).
#
# Allowed actions and why each is required (nothing more):
#   dynamodb:GetItem/PutItem/UpdateItem on GreetingsTable — the counter write is
#     a TransactWriteItems of a Put (dedupe) + Update (counter); DynamoDB
#     authorizes a transaction by its UNDERLYING item actions, so Put + Update
#     are required (not TransactWriteItems). GetItem covers the pre-read/replay.
#   kms:Decrypt on EncryptionKey — the runtime decrypts the CMK-encrypted
#     environment variables at cold start. Decrypt only; the function never
#     encrypts.
#
# Pure stdlib (no cfn/yaml gems): the function's Policies block is sliced out
# textually, so the check runs anywhere (CI, pre-commit) without the AWS
# toolchain.

TEMPLATE = File.expand_path('../infra/template.yaml', __dir__)

# action => the resource logical-id token its statement must scope to.
ALLOWED = {
  'dynamodb:GetItem' => 'GreetingsTable',
  'dynamodb:PutItem' => 'GreetingsTable',
  'dynamodb:UpdateItem' => 'GreetingsTable',
  'kms:Decrypt' => 'EncryptionKey'
}.freeze

def fail_with(messages)
  warn 'iam-check: FAIL'
  messages.each { |m| warn "  - #{m}" }
  exit 1
end

abort "iam-check: template not found at #{TEMPLATE}" unless File.file?(TEMPLATE)

lines = File.readlines(TEMPLATE)

# --- Slice out the function's `Policies:` block ----------------------------
# From the `Policies:` key under GreeterFunction to the next key at the same
# indentation (e.g. `Events:`), which ends the block.
start = lines.index { |l| l.match?(/^      Policies:\s*$/) }
abort 'iam-check: could not find the GreeterFunction Policies block' if start.nil?

policy_indent = lines[start][/\A */].length
policy_lines = [[lines[start], start + 1]]
lines[(start + 1)..].each_with_index do |line, i|
  indent = line[/\A */].length
  break if line.strip != '' && !line.lstrip.start_with?('#') && indent <= policy_indent

  policy_lines << [line, start + 2 + i]
end

problems = []

# --- 1. No "*" wildcard in an Action or Resource within the policy block ----
policy_lines.each do |line, no|
  stripped = line.strip
  next if stripped.start_with?('#')

  if stripped.match?(/\A(Action|Resource)\s*:\s*['"]?\*['"]?\s*\z/) ||
     stripped.match?(/\A-\s*['"]?\*['"]?\s*\z/)
    problems << "wildcard '*' in IAM Action/Resource at line #{no}: #{stripped}"
  end
end

block_text = policy_lines.map(&:first).join

# --- 2. Every action in the block must be in the allowlist ------------------
actions_found = block_text.scan(/[a-z0-9-]+:[A-Za-z*]+/).reject { |t| t.include?('::') }.uniq
disallowed = actions_found - ALLOWED.keys
unless disallowed.empty?
  problems << "action(s) beyond the allowed set (#{ALLOWED.keys.join(', ')}): #{disallowed.sort.join(', ')}"
end

# --- 3. Every Resource line must scope to an allowed logical id -------------
allowed_resource_tokens = ALLOWED.values.uniq
resource_lines = policy_lines.select { |l, _| l.strip.start_with?('Resource:') }
resource_lines.each do |line, no|
  value = line.strip.sub(/\AResource:\s*/, '')
  ok = allowed_resource_tokens.any? { |tok| value.include?(tok) } && value.include?('Arn')
  problems << "Resource at line #{no} is not scoped to #{allowed_resource_tokens.join('/')} ARN: #{value}" unless ok
end
problems << 'no IAM Resource line found in the function policy' if resource_lines.empty?

fail_with(problems) unless problems.empty?

puts 'iam-check: PASS — function policy is least-privilege ' \
     '(GetItem/PutItem/UpdateItem on GreetingsTable, Decrypt on EncryptionKey, no wildcards).'
